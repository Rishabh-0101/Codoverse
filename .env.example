# Copy this file to .env for LOCAL DEVELOPMENT ONLY.
# In production (Vercel), set every one of these under
# Project Settings -> Environment Variables instead — never commit a real
# .env file, and never paste real secret values into any file you send
# anyone (including an AI assistant).

# Any random long string - used to sign login tokens
JWT_SECRET=change_this_to_a_long_random_string

# Port the local API server runs on (only used by `npm run dev:api`)
PORT=3000

# Your deployed site's URL - used to redirect back after Google/GitHub sign-in.
# Locally this is your Vite dev server; in Vercel it's your production domain.
FRONTEND_URL=http://localhost:5173

# REQUIRED for real, persistent user accounts.
# Add the "Postgres" (Neon) integration from your Vercel project's Storage
# tab and it fills this in for you automatically in production. For local
# dev, create a free Neon/Supabase Postgres project and paste its
# connection string here.
POSTGRES_URL=

# OPTIONAL - only needed for the "Analyze a Repo" AI feature
# Get a key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# OPTIONAL - only needed if you hit GitHub API rate limits on sync/analyze
# Create a token at https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=

# OPTIONAL - "Continue with GitHub" sign-in.
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL:
#   local:      http://localhost:3000/api/auth/github/callback
#   production: https://YOUR-DOMAIN/api/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# OPTIONAL - "Continue with Google" sign-in.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI:
#   local:      http://localhost:3000/api/auth/google/callback
#   production: https://YOUR-DOMAIN/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# OPTIONAL - lets "Send Feedback" in Help Center actually email you.
# For Gmail: turn on 2FA, then create an "App Password" and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FEEDBACK_EMAIL_TO=
